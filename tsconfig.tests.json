{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "frontend/src/**/*.test.ts",
    "frontend/src/**/*.test.tsx",
    "backend/src/**/*.test.ts",
    "shared/**/*.test.ts",
    "frontend/vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
