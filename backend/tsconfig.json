{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": ["src", "../shared"],
  "exclude": ["src/**/*.test.ts", "../shared/**/*.test.ts", "dist"]
}
